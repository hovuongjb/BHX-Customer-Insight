# Copy to `.env` in the repo root and CHANGE every secret before any non-local use.
# Docker Compose reads this file for variable substitution; the API (apps/api) also loads it
# when run from apps/api (e.g. `npm run dev`). Never commit the real `.env`.

# --- Database (docker-compose `db` service) ---
POSTGRES_USER=bhx
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=bhx_customer_insight
# Used by the API running ON THE HOST (npm run dev, prisma CLI, seed): the compose db is
# published on host port 5434. Inside Docker Compose the api service overrides this with
# the `db` hostname automatically (see docker-compose.yml), so no change is needed for that.
DATABASE_URL=postgresql://bhx:change_me_please@localhost:5434/bhx_customer_insight?schema=public

# --- API ---
API_PORT=4000
# Long random strings, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# Key for the HMAC of normalized phone numbers (duplicate detection). Changing it later
# makes old phone hashes unmatchable — set once, back it up, don't rotate casually.
PHONE_HASH_SECRET=change_me_to_another_long_random_string
# Exact browser origin of the web app (CORS allow-list). Must match scheme+host+port.
WEB_ORIGIN=http://localhost:5173
# Base URL encoded into survey QR codes (<base>/s/<token>). Must be reachable by customers'
# phones — in production use the public HTTPS domain.
PUBLIC_SURVEY_BASE_URL=http://localhost:5173

# --- Web (baked in at build/dev-server start; restart Vite after changing) ---
VITE_API_BASE_URL=http://localhost:4000/api
